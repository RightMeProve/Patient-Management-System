# ============================================================================
# .gitignore — Files and directories that Git should NOT track
# ============================================================================
# WHY? Some files are generated, contain secrets, or are machine-specific.
# They should never be committed to version control.

# --- IDE Files ---
# These are user-specific IDE configurations. Each developer has different settings.
.idea/
.vscode/
*.iml
*.ipr
*.iws

# --- OS Files ---
.DS_Store
Thumbs.db

# --- Maven Build Output ---
# target/ contains compiled .class files, JARs, and test reports.
# These are regenerated by 'mvn clean install' — no need to track.
**/target/

# --- Maven Wrapper (optional — some teams DO commit these) ---
# .mvn/wrapper/maven-wrapper.jar

# --- Environment & Secrets ---
# NEVER commit credentials, API keys, or environment-specific configs
.env
*.env
application-local.properties
application-secret.properties

# --- Log Files ---
*.log
